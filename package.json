{
	"name": "style-match",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"predev": "kill-port 5000 5173 || true",
		"dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
		"server": "node server/index.js",
		"client": "vite --host 0.0.0.0 --port 5173 --strictPort",
		"build": "vite build",
		"lint": "oxlint",
		"preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
		"start": "node server/index.js",
		"audit-images": "node scripts/audit-images.mjs"
	},
	"dependencies": {
		"@react-three/drei": "^10.7.9",
		"@react-three/fiber": "^9.8.1",
		"@supabase/supabase-js": "^2.118.0",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.21.2",
		"express-rate-limit": "^7.4.1",
		"lucide-react": "^1.55.0",
		"node-cache": "^5.1.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.4",
		"three": "^0.186.1"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^9.1.2",
		"kill-port": "^2.0.1",
		"oxlint": "^1.81.0",
		"vite": "^8.3.4"
	}
}
