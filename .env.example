# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ── Amazon Integration ───────────────────────────────────────────────────────
# Set AMAZON_MODE=demo to use placeholder products (safe default, no credentials needed)
# Set AMAZON_MODE=live only after you have valid Amazon PA-API 5.0 credentials
AMAZON_MODE=demo

# Amazon Product Advertising API 5.0 credentials
# Apply at: https://affiliate-program.amazon.in/
# These are only read by the backend server — never expose them in frontend code
ACCESS_KEY=YOUR_AMAZON_ACCESS_KEY
SECRET_KEY=YOUR_AMAZON_SECRET_KEY
PARTNER_TAG=YOUR_AMAZON_ASSOCIATE_TAG-21

# Amazon marketplace (IN = India)
AMAZON_MARKETPLACE=IN

# ── Supabase (frontend auth) ─────────────────────────────────────────────────
# These go in .env.local (VITE_ prefix makes them available to the browser)
# VITE_SUPABASE_URL=your_supabase_project_url
# VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
